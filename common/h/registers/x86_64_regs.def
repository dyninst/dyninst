// The registers of x86_64, one DEF_REGISTER or DEF_REGISTER_ALIAS each.
//
// No include guard: x86_64_regs.h includes this inside its namespace, and
// common/src/dyn_regs.C includes it again with the macros redefined to
// build a table of the registers' values and names.

  //          (      name,     ID | alias |   cat |        arch)
  DEF_REGISTER(       rax,  BASEA |  FULL |   GPR | Arch_x86_64)
