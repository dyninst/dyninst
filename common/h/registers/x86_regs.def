  DEF_REGISTER(      xmm7,   0x07 |  XMMS |   XMM | Arch_x86)
  DEF_REGISTER(     mxcsr,   0x08 |  FULL | FPCTL | Arch_x86)

  DEF_REGISTER(      ymm0,   0x00 |  YMMS |   YMM | Arch_x86)
  DEF_REGISTER(      ymm1,   0x01 |  YMMS |   YMM | Arch_x86)
