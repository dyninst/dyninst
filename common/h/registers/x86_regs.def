  DEF_REGISTER(       cr6,    0x6 |  FULL |   CTL | Arch_x86)
  DEF_REGISTER(       cr7,    0x7 |  FULL |   CTL | Arch_x86)

  DEF_REGISTER(       dr0,    0x0 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr1,    0x1 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr2,    0x2 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr3,    0x3 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr4,    0x4 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr5,    0x5 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr6,    0x6 |  FULL |   DBG | Arch_x86)
  DEF_REGISTER(       dr7,    0x7 |  FULL |   DBG | Arch_x86)

  DEF_REGISTER(       st0,    0x0 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st1,    0x1 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st2,    0x2 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st3,    0x3 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st4,    0x4 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st5,    0x5 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st6,    0x6 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       st7,    0x7 | FPDBL |   X87 | Arch_x86)
  DEF_REGISTER(       fcw,    0x8 | W_REG | FPCTL | Arch_x86)
  DEF_REGISTER(       fsw,    0x9 | W_REG | FPCTL | Arch_x86)

  DEF_REGISTER(       mm0,    0x0 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm1,    0x1 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm2,    0x2 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm3,    0x3 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm4,    0x4 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm5,    0x5 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm6,    0x6 |   MMS |   MMX | Arch_x86)
  DEF_REGISTER(       mm7,    0x7 |   MMS |   MMX | Arch_x86)

  DEF_REGISTER(      xmm0,   0x00 |  XMMS |   XMM | Arch_x86)
  DEF_REGISTER(      xmm1,   0x01 |  XMMS |   XMM | Arch_x86)
  DEF_REGISTER(      xmm2,   0x02 |  XMMS |   XMM | Arch_x86)
  DEF_REGISTER(      xmm3,   0x03 |  XMMS |   XMM | Arch_x86)
  DEF_REGISTER(      xmm4,   0x04 |  XMMS |   XMM | Arch_x86)
