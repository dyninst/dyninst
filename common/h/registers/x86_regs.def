  DEF_REGISTER(       cr2,    0x2 |  FULL |   CTL | Arch_x86)
  DEF_REGISTER(       cr3,    0x3 |  FULL |   CTL | Arch_x86)
  DEF_REGISTER(       cr4,    0x4 |  FULL |   CTL | Arch_x86)
