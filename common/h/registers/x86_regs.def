// The registers of x86, one DEF_REGISTER or DEF_REGISTER_ALIAS each.
//
// No include guard: x86_regs.h includes this inside its namespace, and
// common/src/dyn_regs.C includes it again with the macros redefined to
// build a table of the registers' values and names.

  //          (      name,     ID | alias |   cat |     arch)
  DEF_REGISTER(       eax,  BASEA |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        ax,  BASEA | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(        ah,  BASEA | H_REG |   GPR | Arch_x86)
  DEF_REGISTER(        al,  BASEA | L_REG |   GPR | Arch_x86)
  DEF_REGISTER(       ecx,  BASEC |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        cx,  BASEC | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(        ch,  BASEC | H_REG |   GPR | Arch_x86)
  DEF_REGISTER(        cl,  BASEC | L_REG |   GPR | Arch_x86)
  DEF_REGISTER(       edx,  BASED |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        dx,  BASED | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(        dh,  BASED | H_REG |   GPR | Arch_x86)
  DEF_REGISTER(        dl,  BASED | L_REG |   GPR | Arch_x86)
  DEF_REGISTER(       ebx,  BASEB |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        bx,  BASEB | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(        bh,  BASEB | H_REG |   GPR | Arch_x86)
  DEF_REGISTER(        bl,  BASEB | L_REG |   GPR | Arch_x86)
  DEF_REGISTER(       esp, BASESP |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        sp, BASESP | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(       ebp, BASEBP |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        bp, BASEBP | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(       esi, BASESI |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        si, BASESI | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(       edi, BASEDI |  FULL |   GPR | Arch_x86)
  DEF_REGISTER(        di, BASEDI | W_REG |   GPR | Arch_x86)
  DEF_REGISTER(       eip,   0x10 |  FULL |         Arch_x86)

  DEF_REGISTER(        cs, BASECS | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        ds, BASEDS | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        es, BASEES | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        ss, BASESS | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        fs, BASEFS | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        gs, BASEGS | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(      gdtr, BASEGD | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(      ldtr, BASELD | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(      idtr, BASEID | W_REG |   SEG | Arch_x86)
  DEF_REGISTER(        tr, BASETR | W_REG |   SEG | Arch_x86)

  DEF_REGISTER(     flags,  FLAGS |  FULL |  FLAG | Arch_x86)
  DEF_REGISTER(        cf,     CF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flag1,  FLAG1 |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        pf,     PF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flag3,  FLAG3 |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        af,     AF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flag5,  FLAG5 |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        zf,     ZF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        sf,     SF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        tf,     TF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(       if_,     IF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        df,     DF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        of,     OF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flagc,  FLAGC |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flagd,  FLAGD |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(       nt_,     NT |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(     flagf,  FLAGF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        rf,     RF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        vm,     VM |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        ac,     AC |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(       vif,    VIF |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(       vip,    VIP |   BIT |  FLAG | Arch_x86)
  DEF_REGISTER(        id,     ID |   BIT |  FLAG | Arch_x86)

  DEF_REGISTER(       cr0,    0x0 |  FULL |   CTL | Arch_x86)
